{
  "duration": 58.937917,
  "cues": [
    {
      "i": 1,
      "id": "p01",
      "illo": "intro",
      "speaker": "Your SuperWho",
      "voice": "en-US-EmmaNeural",
      "start": 0.0,
      "end": 8.903,
      "text": "Hi Rosa \u2014 I\u2019m your SuperWho, built for Life Remodeled. Jim, your dad, and his team developed me to bring both Opportunity Hubs into one place."
    },
    {
      "i": 2,
      "id": "p02",
      "illo": "stats",
      "speaker": "Your SuperWho",
      "voice": "en-US-EmmaNeural",
      "start": 9.253,
      "end": 20.289,
      "text": "Instead of juggling spreadsheets, email threads, and ten-thousand-dollar property software, your dashboard tracks active nonprofits, open maintenance work, and this week\u2019s room schedule at a glance."
    },
    {
      "i": 3,
      "id": "p03",
      "illo": "tenants",
      "speaker": "Your SuperWho",
      "voice": "en-US-EmmaNeural",
      "start": 20.639,
      "end": 30.053,
      "text": "Switch between Hub 1 and Hub 2, or view both together. You can search the tenant directory, send hub-wide announcements, and see which organizations have seen them."
    },
    {
      "i": 4,
      "id": "p04",
      "illo": "maintenance",
      "speaker": "Your SuperWho",
      "voice": "en-US-EmmaNeural",
      "start": 30.403,
      "end": 39.554,
      "text": "Maintenance requests stay moving from submitted to in progress to done \u2014 so no leaky valve, door lock, or HVAC ticket gets buried in your inbox."
    },
    {
      "i": 5,
      "id": "p05",
      "illo": "events",
      "speaker": "Your SuperWho",
      "voice": "en-US-EmmaNeural",
      "start": 39.904,
      "end": 47.325,
      "text": "Your shared calendar and room booking view keeps gyms, classrooms, and community spaces clear of double-bookings across both buildings."
    },
    {
      "i": 6,
      "id": "p06",
      "illo": "form",
      "speaker": "Your SuperWho",
      "voice": "en-US-EmmaNeural",
      "start": 47.675,
      "end": 58.038,
      "text": "When a tenant needs something, the request form on this page routes it straight in and alerts the team right away. Everything here uses labeled sample data so you can test it safely before your meeting."
    }
  ],
